// flash-trade-bot — Pine strategy template (schema-only example)
//
// This file is a MINIMAL EXAMPLE showing how your Pine strategy must emit
// webhook alerts that this bot can consume. The strategy logic here is
// intentionally trivial (a basic EMA cross) — REPLACE it with your own.
//
// The part you must NOT change is the alert() JSON payload shape. The bot's
// validator (src/verify.ts) rejects any payload missing these fields or with
// the wrong types.
//
// Required fields in the webhook JSON body:
//   secret                 — must match WEBHOOK_SECRET env var on the bot
//   id                     — unique per fire; bot dedupes on this
//   action                 — "buy" | "sell"
//   ticker                 — e.g. "BTCUSD"
//   contracts              — numeric string (TradingView's strategy.order.contracts)
//   price                  — numeric string > 0
//   position_size_after    — numeric string; 0 when flat
//   market_position        — "long" | "short" | "flat"
//   prev_market_position   — "long" | "short" | "flat"
//   order_comment          — free text; used for logging
//   time                   — ISO timestamp
//
// The bot uses (prev_market_position, market_position) to derive the intent:
//   flat  → long  = open long
//   flat  → short = open short
//   long  → flat  = close long
//   short → flat  = close short
//   long  → short = flip (atomic on mainnet)
//   short → long  = flip (atomic on mainnet)
//   any same→same = noop
//
// Configure ONE TradingView alert per strategy, set "Message" to the JSON
// below (literal, with {{...}} placeholders filled by TradingView), set URL
// to https://<your-railway-url>/webhook, and set trigger to "alert() function
// calls only". The alert_message below is what TradingView sends.

//@version=6
strategy("flash-trade-bot schema example",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     process_orders_on_close=true)

// --- inputs ---------------------------------------------------------------
fastLen = input.int(20,  "Fast EMA")
slowLen = input.int(50,  "Slow EMA")

// --- indicators -----------------------------------------------------------
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)

plot(fastEma, color=color.blue,   title="Fast EMA")
plot(slowEma, color=color.orange, title="Slow EMA")

// --- signals (REPLACE with your real strategy) ----------------------------
longSignal  = ta.crossover(fastEma,  slowEma)
shortSignal = ta.crossunder(fastEma, slowEma)

// --- webhook JSON template ------------------------------------------------
// Paste your WEBHOOK_SECRET into TradingView's alert dialog — it replaces
// the {{SECRET}} placeholder when the alert is saved. Do NOT hardcode the
// secret in this source.

alertJson(action, comment) =>
    '{' +
      '"secret":"{{SECRET}}",' +
      '"id":"' + str.tostring(time) + '-' + action + '",' +
      '"action":"'               + action + '",' +
      '"ticker":"'               + syminfo.ticker   + '",' +
      '"contracts":"'            + str.tostring(strategy.position_size) + '",' +
      '"price":"'                + str.tostring(close)             + '",' +
      '"position_size_after":"'  + str.tostring(strategy.position_size) + '",' +
      '"market_position":"'      + (strategy.position_size > 0 ? "long" : strategy.position_size < 0 ? "short" : "flat") + '",' +
      '"prev_market_position":"' + (strategy.position_size[1] > 0 ? "long" : strategy.position_size[1] < 0 ? "short" : "flat") + '",' +
      '"order_comment":"'        + comment   + '",' +
      '"time":"'                 + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"' +
    '}'

// --- orders + alerts ------------------------------------------------------
if longSignal
    strategy.entry("long", strategy.long)
    alert(alertJson("buy",  "ema-cross long"),  alert.freq_once_per_bar_close)

if shortSignal
    strategy.entry("short", strategy.short)
    alert(alertJson("sell", "ema-cross short"), alert.freq_once_per_bar_close)
