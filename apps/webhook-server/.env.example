# flash-trade-bot — environment template
#
# Copy to .env and fill in. After creating .env:
#   chmod 600 .env
# Only the user that runs the bot should be able to read it.
#
# Required vs optional is documented per-variable below. The authoritative
# loader + validation lives in src/config.ts:loadConfig().
#
# Never commit .env. Never paste .env contents into chat, tickets, screenshots,
# or an LLM. See SECURITY-NOTES.md.

# ---------------------------------------------------------------------------
# Network & safety guards
# ---------------------------------------------------------------------------

# "mainnet-beta" for production. "devnet" is DORMANT — flash.trade's devnet
# program is decommissioned and trades fail with UnsupportedProgramId. The
# server logs a loud warning at boot if NETWORK=devnet.
NETWORK=mainnet-beta

# Real-money acknowledgment. Required to start the server on mainnet-beta
# unless DRY_RUN_ONLY=true. The value must be the literal string "yes".
# Setting this is an explicit act — treat it as a signed statement.
I_UNDERSTAND_REAL_MONEY=no

# Dry-run mode. When true:
#   - PRIVATE_KEY is NOT loaded (never read from env).
#   - ApiBackend short-circuits before signing or broadcasting.
#   - The HTTP server REFUSES to start (dry-run is for scripts/dry-run.ts only).
# Use DRY_RUN_ONLY=true with `npm run dryrun` for API-shape validation.
DRY_RUN_ONLY=false

# RESUME=true clears the persisted halt flag on boot. One-shot: set it, boot
# the bot, then remove the line so the halt state isn't auto-cleared next
# restart. Halts persist in ledger.db (bot_state table) across restarts.
# RESUME=true

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------

# Solana JSON-RPC endpoint. Public RPCs (api.mainnet-beta.solana.com) are
# rate-limited and will drop webhook-triggered sends under load. Use a paid
# provider (Helius, QuickNode, Triton, etc.). Required on mainnet when
# DRY_RUN_ONLY=false.
RPC_URL_MAINNET=

# Optional secondary RPC for failover. When the primary RPC throws a
# timeout, rate-limit, 5xx, or "dropped" error, the bot retries once on
# this fallback. Highly recommended in production — one provider outage
# will not kill trades. Free tiers from a different vendor work fine
# (e.g. primary=Helius, fallback=Triton or QuickNode).
# RPC_URL_MAINNET_FALLBACK=

# Devnet RPC. Only needed if NETWORK=devnet. Dormant path — see note above.
# RPC_URL_DEVNET=https://api.devnet.solana.com

# Pyth price feeds. Used by the devnet SDK path only; mainnet ApiBackend
# gets prices from flash.trade's backend. Default is fine.
# PYTHNET_URL=https://pythnet.rpcpool.com

# flash.trade HTTP API base URL. Override only to point at a staging mirror.
# FLASH_API_BASE_URL=https://flashapi.trade

# ---------------------------------------------------------------------------
# Wallet
# ---------------------------------------------------------------------------

# Base58-encoded Solana secret key for the bot wallet. Required when
# DRY_RUN_ONLY=false. Generate FRESH on the VPS with `solana-keygen new`
# and convert to base58 — do NOT reuse a laptop wallet. Fund with the
# minimum USDC + SOL needed. Treat this file as live credentials.
PRIVATE_KEY=

# Dry-run only: the pubkey used as `owner` in flash.trade API calls. The
# private key is intentionally NOT loaded in dry-run, so the wallet can
# never sign. Any valid base58 Solana pubkey works for shape validation.
# DRY_RUN_WALLET_PUBKEY=

# ---------------------------------------------------------------------------
# Webhook
# ---------------------------------------------------------------------------

# Shared secret required in every TradingView alert body. Generate with:
#   openssl rand -hex 32
# Rotate on every deploy. Update every TradingView alert the same minute
# you rotate — there is no grace period, the bot rejects the old secret
# immediately (constant-time comparison, see src/verify.ts).
WEBHOOK_SECRET=

# HTTP port. The server binds 127.0.0.1 only — external ingress is the
# Cloudflare named tunnel's job. Don't change the bind address without
# also changing the deploy topology.
PORT=3000

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# BotFather token for the bot that sends trade notifications.
# Required when DRY_RUN_ONLY=false.
TELEGRAM_BOT_TOKEN=

# Numeric chat id (user, group, or channel) that receives messages.
# Required when DRY_RUN_ONLY=false.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Trading parameters
# ---------------------------------------------------------------------------

# Asset symbol on flash.trade. Must match a market name. Default: BTC.
ASSET=BTC

# Collateral per position, in USDC (ui units, not native). Cap your
# exposure here — every open uses this amount. Range: 0.01 to 100000.
COLLATERAL_USDC=20

# Leverage multiplier. Notional position size = COLLATERAL_USDC * LEVERAGE.
# Range: 1 to 100. Be conservative — flash.trade liquidates aggressively.
LEVERAGE=2

# Slippage tolerances in basis points (bps). 100 bps = 1%.
# Entry uses a tighter tolerance than exit because exiting is higher
# priority (we want the close to go through even in fast markets).
# Range for both: 1 to 5000.
SLIPPAGE_ENTRY_BPS=100
SLIPPAGE_EXIT_BPS=150

# Daily realized-loss circuit breaker in USDC. When realized PnL since UTC
# midnight drops below -MAX_DAILY_LOSS_USDC, the bot halts: closes still
# go through, but new opens are refused until RESUME=true is set.
# Range: 0 to 1e9. Set to 0 to disable (not recommended).
MAX_DAILY_LOSS_USDC=15

# ---------------------------------------------------------------------------
# Dashboard integration (optional)
# ---------------------------------------------------------------------------

# Bearer token required on /status, /pause, /resume when set. When unset,
# those endpoints are open for backward compat with v0 deploys. Generated
# by the setup dashboard (flashtradebot.xyz) during onboarding. Rotate
# along with WEBHOOK_SECRET if either leaks.
# DASHBOARD_TOKEN=

# CORS origin allowlist for dashboard-initiated requests. Comma-separated.
# Default when unset: https://flashtradebot.xyz, https://www.flashtradebot.xyz,
# http://localhost:3001. Override if self-hosting the dashboard on your own
# domain.
# DASHBOARD_ORIGIN=https://your-dashboard.example.com
