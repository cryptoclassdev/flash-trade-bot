{
  "name": "flash-trade-bot",
  "version": "0.1.0",
  "private": true,
  "description": "TradingView webhook -> flash.trade automated trading bot",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node --transpile-only src/server.ts",
    "fire": "ts-node --transpile-only scripts/fire-test-webhook.ts",
    "dryrun": "ts-node --transpile-only scripts/dry-run.ts",
    "balance": "ts-node --transpile-only scripts/check-balance.ts",
    "trades": "ts-node --transpile-only scripts/show-trades.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@pythnetwork/client": "^2.22.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "flash-sdk": "^2.39.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
